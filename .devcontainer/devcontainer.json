{
    "name": "Lichens CPP Dev Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "formulahendry.code-runner",
                "ms-vscode.cpptools-extension-pack",
                "doi.fileheadercomment",
                "anthropic.claude-code"
            ],
            "settings": {
                "cmake.configureOnOpen": true,
                "C_Cpp.default.cStandard": "c23",
                "C_Cpp.default.intelliSenseMode": "linux-clang-x64",
                "C_Cpp.default.compilerPath": "/usr/bin/clang",
                "fileHeaderComment.parameter": {
                    "*": {
                        "Author": "${user}",
                        "Date": "Created on ${date}",
                        "commentbegin": "/*",
                        "commentprefix": " *",
                        "commentend": " */",
                        "company": "Lichens",
                        "Copyright": "Copyright (C) Lichens - All Rights Reserved",
                        "License": "See LICENSE file for more details."
                    }
                },
                "fileHeaderComment.template": {
                    "*":[
                        "${commentbegin}",
                        "${commentprefix}",
                        "${commentprefix} Copyright (c) ${year} ${company}",
                        "${commentprefix}",
                        "${commentprefix} ${License}",
                        "${commentprefix}",
                        "${commentprefix} Created on ${date}",
                        "${commentend}"
                    ]
                }
            }
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind",
        "source=lichens-cpp-claude-devcontainer-auth,target=/home/devuser/.claude,type=volume",
        "source=lichens-cpp-claude-devcontainer-json,target=/home/devuser/.claude.json,type=volume"
    ],
    "postStartCommand": "sudo chown -R devuser:devuser /home/devuser/.claude /home/devuser/.claude.json",
    "workspaceFolder": "/workspace",
    "remoteUser": "devuser"
  }